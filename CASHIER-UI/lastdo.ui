                                 <property name="styleSheet">
                                  <string notr="true">
/* Default Inactive Button */
QPushButton {
    background-color: #ffffff;
    color: black;
    border-radius: 15px;
border: 1px solid #000000; 
    padding: 9px;
font-family: &quot;Verdana&quot;, sans-serif; 
text-align: center;
}

/* Hover Effect on Inactive Buttons */
QPushButton:hover {
    background-color: #a6a6a6;
    color: white;
}

/* Active Button (Current Page) */
QPushButton#activeButton {
    background-color: #a6a6a6;
    color: white;
}
