                                  <string notr="true">
/* Default Inactive Button */
QPushButton {
    background-color: #ffffff;
    color: black;
    border-radius: 15px;
border: 1px solid #000000; 
    padding: 9px;
font-family: &quot;Verdana&quot;, sans-serif; 
